# PROD environment secrets — copy to .env.prod and fill in values
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# NEVER commit .env.prod — all values must be strong, unique secrets

# External Vault address (production Vault cluster, not in Docker)
VAULT_HOST=
VAULT_TOKEN=

# Database password
PRODUCT_DB_PASSWORD=

# GitHub PAT with read:packages scope, used at `docker compose build` time
GITHUB_TOKEN=
