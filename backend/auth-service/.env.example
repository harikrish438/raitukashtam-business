# DEV environment secrets — copy to .env and fill in values.
# .env is gitignored and never committed.
# See also: .env.test.example, .env.prod.example

# Vault root token (dev mode) — must match the repo root's .env VAULT_TOKEN
VAULT_TOKEN=raitukashtam-vault-token

# Database password — must match the repo root's .env AUTH_DB_PASSWORD
# (vault-init seeds Vault with the root .env's copy; this is what
# auth-postgres itself is actually started with)
AUTH_DB_PASSWORD=jwt_password

# Redis password — must match the repo root's .env REDIS_PASSWORD
REDIS_PASSWORD=your_redis_password

# Gmail address auth-service sends mail FROM (the app password itself is
# supplied via Vault, seeded from the repo root's .env MAIL_PASSWORD)
MAIL_USERNAME=raitukashtam@gmail.com

# Google OAuth client ID (auth-service Google login) — not a secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Google reCAPTCHA site key (auth-service login-attempt captcha) — not a
# secret; the matching secret key is supplied via Vault
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Where auth-service redirects after a successful web login
WEB_CLIENT_REDIRECT_URI=http://localhost:3000/callback

# CORS origins allowed to call auth-service
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL auth-service uses to build links in emails/redirects
APP_BASE_URL=http://localhost:8080/

# Email of the account to bootstrap as the first PLATFORM_ADMIN in this
# environment. No-op if unset. One-time flow: set this, register the email
# via the public /users/register endpoint, then restart this service once
# -- PlatformAdminSeeder promotes it on that boot. From then on, onboard
# further products/roles/clients via the PLATFORM_ADMIN API
# (POST /products, /products/{code}/roles, /products/{code}/clients) rather
# than code changes — see repo-root CLAUDE.md.
# raitukashtam@gmail.com is the standing convention for the first
# PLATFORM_ADMIN in every environment (dev/test/prod) -- same account as
# MAIL_USERNAME above.
PLATFORM_ADMIN_EMAIL=raitukashtam@gmail.com
