# PROD environment secrets — copy to .env.prod and fill in values
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# NEVER commit .env.prod — all values must be strong, unique secrets

# Must match the repo root's .env.prod VAULT_TOKEN
VAULT_TOKEN=

# Database password — must match the repo root's .env.prod AUTH_DB_PASSWORD
AUTH_DB_PASSWORD=

# Must match the repo root's .env.prod REDIS_PASSWORD
REDIS_PASSWORD=

MAIL_USERNAME=

GOOGLE_CLIENT_ID=
RECAPTCHA_SITE_KEY=

WEB_CLIENT_REDIRECT_URI=
CORS_ALLOWED_ORIGINS=
APP_BASE_URL=

# Bootstraps the first PLATFORM_ADMIN — see .env.example for the one-time
# register-then-restart flow. No-op if unset. raitukashtam@gmail.com is the
# standing convention for the first PLATFORM_ADMIN in every environment.
PLATFORM_ADMIN_EMAIL=raitukashtam@gmail.com
