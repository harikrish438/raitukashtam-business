# TEST environment secrets — copy to .env.test and fill in values
# Used with: docker compose -f docker-compose.test.yml --env-file .env.test up -d

# Must match the repo root's .env.test VAULT_TOKEN
VAULT_TOKEN=

# Database password (test-specific, different from dev) — must match the
# repo root's .env.test AUTH_DB_PASSWORD
AUTH_DB_PASSWORD=

# Must match the repo root's .env.test REDIS_PASSWORD
REDIS_PASSWORD=

MAIL_USERNAME=

GOOGLE_CLIENT_ID=
RECAPTCHA_SITE_KEY=

WEB_CLIENT_REDIRECT_URI=
CORS_ALLOWED_ORIGINS=
APP_BASE_URL=

# Bootstraps the first PLATFORM_ADMIN — see .env.example for the one-time
# register-then-restart flow. No-op if unset.
PLATFORM_ADMIN_EMAIL=
