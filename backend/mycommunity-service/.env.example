# DEV environment secrets — copy to .env and fill in values.
# .env is gitignored and never committed.
# See also: .env.test.example, .env.prod.example

# Vault root token (dev mode, auto-accepted by this repo's own root
# vault-init — must match the root .env's VAULT_TOKEN)
VAULT_TOKEN=raitukashtam-vault-token

# Database password
MYCOMMUNITY_DB_PASSWORD=mycommunity-service-password
