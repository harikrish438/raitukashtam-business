# DEV environment secrets — copy to .env and fill in values.
# .env is gitignored and never committed.
# See also: .env.test.example, .env.prod.example
#
# This file is for the repo-root shared infra stack (Vault + Redis) only.
# Each service under backend/<service>/ has its own .env(.example) for its
# own DB password and (for mycommunity-service) GITHUB_TOKEN.

# Vault root token (dev mode, auto-accepted by vault-init)
VAULT_TOKEN=raitukashtam-vault-token

# JWT signing secret — must match AUTH_SERVICE's and MYCOMMUNITY_SERVICE's .env
JWT_SECRET=change-this-to-a-strong-secret-minimum-32-chars

# OAuth2 Authorization Server RSA signing keypair (auth-service), base64 DER.
# This is a real but dev-only, non-sensitive keypair checked into git —
# generate your own for test/prod, never reuse this one there. Use a
# jshell one-liner, NOT `openssl genpkey` -- its PKCS8 encoding is not
# decodable by this JDK's KeyFactory ("algid parse error, not a sequence",
# confirmed live against this same keypair in the platform repo):
#   jshell -q <<'EOF'
#   import java.security.*; import java.util.Base64;
#   var kp = KeyPairGenerator.getInstance("RSA"); kp.initialize(2048);
#   var pair = kp.generateKeyPair();
#   System.out.println(Base64.getEncoder().encodeToString(pair.getPrivate().getEncoded()));
#   System.out.println(Base64.getEncoder().encodeToString(pair.getPublic().getEncoded()));
#   EOF
# (first line printed -> JWT_SIGNING_KEY_PRIVATE, second -> JWT_SIGNING_KEY_PUBLIC)
JWT_SIGNING_KEY_
JWT_SIGNING_KEY_

# Database passwords (each service also declares its own copy in its own
# .env — must match what you set there)
AUTH_DB_PASSWORD=jwt_password
MYCOMMUNITY_DB_PASSWORD=mycommunity-service-password

# Redis password
REDIS_PASSWORD=your_redis_password

# Gmail SMTP app password used by auth-service to send emails
MAIL_PASSWORD=your_gmail_app_password

# Google reCAPTCHA secret key (auth-service login-attempt captcha)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# 2Factor.in API key used by auth-service to send OTP SMS
TWOFACTOR_API_KEY=your_2factor_api_key
