# TEST environment secrets — copy to .env.test and fill in values.
# .env.test is gitignored and never committed.
#
# This file is for the repo-root shared infra stack (Vault + Redis) only.
# Each service under backend/<service>/ has its own .env.test(.example).

VAULT_TOKEN=generate-a-real-token-for-test

# JWT signing secret — must match AUTH_SERVICE's and MYCOMMUNITY_SERVICE's .env.test
JWT_SECRET=generate-a-strong-secret-minimum-32-chars

# OAuth2 Authorization Server RSA signing keypair (auth-service), base64 DER.
# Generate your own — do NOT reuse the dev keypair from .env.example here.
# See .env.example for the jshell one-liner to generate a fresh pair.
JWT_SIGNING_KEY_PRIVATE=generate-your-own-test-keypair
JWT_SIGNING_KEY_PUBLIC=generate-your-own-test-keypair

# Database passwords (each service also declares its own copy in its own
# .env.test — must match what you set there)
AUTH_DB_PASSWORD=generate-a-real-password-for-test
MYCOMMUNITY_DB_PASSWORD=generate-a-real-password-for-test

# Redis password
REDIS_PASSWORD=generate-a-real-password-for-test

# Gmail SMTP app password used by auth-service to send emails
MAIL_PASSWORD=your_gmail_app_password

# Google reCAPTCHA secret key (auth-service login-attempt captcha)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# 2Factor.in API key used by auth-service to send OTP SMS
TWOFACTOR_API_KEY=your_2factor_api_key
